<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="server.mapper.GroupMemberMapper">
    <insert id="batchJoin" parameterType="java.util.List">
        INSERT INTO group_member (id,group_id, user_id)
        VALUES
        <foreach collection="userId" item="userId" index="index" separator=",">
            ('${@com.baomidou.mybatisplus.core.toolkit.IdWorker@getId()}',#{groupId},#{userId})
        </foreach>
    </insert>
</mapper>