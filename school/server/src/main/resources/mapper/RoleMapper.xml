<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="server.mapper.RoleMapper">
    <update id="updateRole">
        UPDATE role
        <set>
            <if test="roleName != null">
                role_name = #{roleName},
            </if>
            <if test="roleCode != null">
                role_code = #{roleCode},
            </if>
            <if test="statusEnum != null">
                status_enum = #{statusEnum}
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="updateRoleUser">
        UPDATE user_role
        <set>
            <if test="userId != null">
                user_id = #{userId},
            </if>
            <if test="roleId != null">
                role_id = #{roleId}
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <select id="pageSelectRole" resultType="com.school.vo.role.PageSelectRoleVO">
        SELECT *
        FROM role
        <where>
            <if test="roleCode != null">
                role_code LIKE CONCAT{'%', #{roleCode}, '%'}
            </if>
            <if test="roleName != null">
                role_name LIKE CONCAT{'%', #{roleName}, '%'}
            </if>
            <if test="statusEnum !=null">
                status_enum = #{statusEnum}
            </if>
        </where>
    </select>

    <delete id="deleteRolePermission">
        DELETE FROM role_permission
        WHERE role_id = #{id}
        AND permission_id IN
        <foreach collection="deletePermissionIdList" item="item" open="(" close=")" separator=",">
            #{item}
        </foreach>
    </delete>

    <insert id="addRolePermission">
        INSERT INTO role_permission (id, role_id, permission_id)
        VALUES
        <foreach collection="permissionIds" item="permissionId" index="index" separator=",">
            (#{ids[${index}]}, #{roleId}, #{permissionId})
        </foreach>
    </insert>

    <select id="selectAddPermissionIdList" resultType="java.lang.String">
        SELECT p.id FROM permission as p
        WHERE p.id IN
        <foreach collection="addPermissionIdList" item="item" open="(" close=")" separator=",">
            #{item}
        </foreach>
    </select>

    <select id="selectDeletePermissionIdList" resultType="java.lang.String">
        SELECT p.id FROM permission as p
        WHERE p.id IN
        <foreach collection="deletePermissionIdList" item="item" open="(" close=")" separator=",">
            #{item}
        </foreach>
    </select>

    <select id="selectExistingPermissions" resultType="java.lang.String">
        SELECT p.name FROM role_permission
        LEFT JOIN permission as p ON permission_id = p.id
        WHERE role_id = #{id}
        AND permission_id IN
        <foreach collection="addPermissionIdList" item="item" open="(" close=")" separator=",">
            #{item}
        </foreach>
    </select>

    <resultMap id="selectPermissionIdMap" type="com.school.vo.role.SelectRolePermissionIdVO">
        <id property="id" column="id" />
        <result property="name" column="name" />
        <result property="code" column="code" />
        <result property="parentId" column="parent_id" />
        <result property="permissionType" column="permission_type" />
    </resultMap>
    <resultMap id="selectRolePermissionMap" type="com.school.vo.role.SelectRolePermissionVO">
        <id property="id" column="role_id" />
        <result property="roleName" column="role_name" />
        <result property="roleCode" column="role_code" />
        <association property="permissionIdList" javaType="java.util.List" resultMap="selectPermissionIdMap" />
    </resultMap>
    <select id="selectRolePermissionId" resultMap="selectRolePermissionMap">
        SELECT r.id as role_id,r.role_name,r.role_code,p.id,p.name,p.code,p.parent_id,p.permission_type
        FROM role as r
        LEFT JOIN role_permission as rp ON r.id = rp.role_id
        LEFT JOIN permission as p ON rp.permission_id = p.id
        WHERE r.id=#{id}
    </select>
</mapper>