<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="server.mapper.DepartmentMapper">

    <update id="updateDepartment">
        UPDATE department
        <set>
            <if test="name != null">
                name = #{name}
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <select id="pageQueryDepartment" resultType="com.school.vo.deparrtment.SelectDepartmentVO">
        SELECT *
        FROM department
        <where>
            <if test="name != null">
                name LIKE CONCAT('%', #{name}, '%')
            </if>
        </where>
    </select>
</mapper>